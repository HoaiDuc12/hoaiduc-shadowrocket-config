#!name=Locket Gold - Hoai Duc - Experimental
#!desc=Client-side Gold state only. Replace YOUR_GITHUB in both script URLs before use.

[Script]
hd.locket.request = type=http-request,pattern=^https:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers\/[^/?]+)(\?.*)?$,script-path=https://raw.githubusercontent.com/HoaiDuc12/hoaiduc-shadowrocket-config/main/locket-gold.js
hd.locket.response = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers\/[^/?]+)(\?.*)?$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/HoaiDuc12/hoaiduc-shadowrocket-config/main/locket-gold.js

[MITM]
hostname = %APPEND% api.revenuecat.com
